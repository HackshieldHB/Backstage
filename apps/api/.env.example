# PostgreSQL (docker compose default; portable toolchain uses no password)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backstages

# Redis
REDIS_URL=redis://localhost:6379

# HTTP
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Auth (generate real secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m

# Encryption key for Atlassian OAuth tokens at rest (32-byte hex)
TOKEN_ENCRYPTION_KEY=change-me-64-hex-chars

# File uploads
UPLOAD_DIR=./uploads
