# PostgreSQL (docker compose default; portable toolchain uses no password)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backstages

# Redis
REDIS_URL=redis://localhost:6379

# HTTP
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Auth (generate real secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m

# Encryption key for Atlassian OAuth tokens at rest (32-byte hex)
TOKEN_ENCRYPTION_KEY=change-me-64-hex-chars

# Public base URL of THIS API, used to build webhook URLs handed to Bitbucket.
# Falls back to WEB_ORIGIN, then localhost.
PUBLIC_API_URL=http://localhost:3001

# Email. Without SMTP_HOST the console adapter is used and password-reset /
# invite emails are only written to the log — fine locally, broken in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Backstages <no-reply@example.com>

# File uploads. STORAGE_DRIVER=disk (default) | s3
STORAGE_DRIVER=disk
UPLOAD_DIR=./uploads

# Required when STORAGE_DRIVER=s3. S3_ENDPOINT is optional and only needed for
# S3-compatible providers (MinIO, R2, Spaces).
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Error reporting. Leave empty to disable.
SENTRY_DSN=

# Atlassian OAuth 2.0 (3LO) app — see docs/atlassian-setup.md
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:3001/atlassian/callback
