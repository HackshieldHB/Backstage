generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum NotificationPref {
  ALL
  MENTIONS
  MUTED
}

enum MessageKind {
  USER
  SYSTEM
  INTEGRATION
}

enum MentionType {
  USER
  CHANNEL
  HERE
}

enum NotificationType {
  MENTION
  THREAD_REPLY
  REACTION
  DM
  CHANNEL_MESSAGE
  SYSTEM
}

enum ActivityKind {
  MEETING
  IMPLEMENTATION
  DOCUMENTATION
  COLLABORATION
  WORK_LOGGED
  ONLINE
  AWAY
}

enum ActivitySource {
  JIRA_WORKLOG
  JIRA_STATUS
  CONFLUENCE
  HUDDLE
  MESSAGE
  PRESENCE
}

/// The family a recommendation belongs to. Used to scope feedback so a dismissal
/// of one people-suggestion never hides an unrelated channel-suggestion.
enum RecommendationKind {
  PERSON
  CHANNEL
  PRIORITY
  FOCUS
  EXPERT
  CATCHUP
  KNOWLEDGE
  FOLLOWUP
}

enum RecommendationAction {
  DISMISSED
  ACTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  /// Null for provisional members created from an Atlassian directory sync (no password until activation).
  passwordHash    String?
  displayName     String
  avatarUrl       String?
  isProvisional   Boolean   @default(false)
  statusEmoji     String?
  statusText      String?
  statusExpiresAt DateTime?
  /// When set and in the future, desktop notifications are snoozed (DND).
  dndUntil        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownedWorkspaces         Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships    WorkspaceMember[]
  invitesCreated          WorkspaceInvite[]     @relation("InviteCreator")
  invitesUsed             WorkspaceInvite[]     @relation("InviteUser")
  channelsCreated         Channel[]             @relation("ChannelCreator")
  channelMemberships      ChannelMember[]
  conversationMemberships ConversationMember[]
  messages                Message[]
  reactions               Reaction[]
  attachments             Attachment[]
  pinnedMessages          PinnedMessage[]
  savedItems              SavedItem[]
  mentions                Mention[]
  notifications           Notification[]        @relation("NotificationRecipient")
  notificationsActed      Notification[]        @relation("NotificationActor")
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  atlassianLink           AtlassianAccountLink?
  atlassianConnections    AtlassianConnection[] @relation("AtlassianConnector")
  scheduledMessages       ScheduledMessage[]
  customEmojis            CustomEmoji[]
  shareLinks              ShareLink[]
  workflows               Workflow[]
  userGroupsCreated       UserGroup[]          @relation("UserGroupCreator")
  userGroupMemberships    UserGroupMember[]
  pollVotes               PollVote[]
  pushSubscriptions       PushSubscription[]
  auditLogs               AuditLog[]           @relation("AuditActor")
  canvasEdits             Canvas[]             @relation("CanvasEditor")
  activitySegments        ActivitySegment[]
  huddleParticipations    HuddleParticipant[]
  timesheetEntries        TimesheetEntry[]
  utilizationDays         UtilizationDaily[]
  standupsCreated         Standup[]            @relation("StandupCreator")
  standupMemberships      StandupMember[]
  standupResponses        StandupResponse[]
  webhooksCreated         IncomingWebhook[]    @relation("WebhookCreator")
  customCommands          CustomCommand[]
  weeklyReports           WeeklyReport[]       @relation("WeeklyReportCreator")
  decisionsCreated        Decision[]           @relation("DecisionCreator")
  decisionsDecided        Decision[]           @relation("DecisionDecider")
  decisionsOwned          Decision[]           @relation("DecisionOwner")
  jiraSavedWidgets        JiraSavedWidget[]    @relation("JiraWidgetCreator")
  jiraAlertRules          JiraAlertRule[]      @relation("JiraAlertCreator")
  incidentsDeclared       Incident[]           @relation("IncidentDeclarer")
  incidentsCommanded      Incident[]           @relation("IncidentCommander")
  incidentUpdates         IncidentUpdate[]     @relation("IncidentUpdateAuthor")
  oncallShifts            OncallShift[]
  calendarLink            CalendarLink?
  recommendationFeedback  RecommendationFeedback[]
  scheduledHuddles        ScheduledHuddle[]    @relation("ScheduledHuddleCreator")
}

model ShareLink {
  id          String    @id @default(cuid())
  /// Opaque, URL-safe token embedded in the public share URL.
  token       String    @unique
  workspaceId String
  /// A shared channel (read-only view of its recent messages)…
  channelId   String?
  /// …or a shared thread (a root message + its replies). Exactly one is set.
  messageId   String?
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  expiresAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message   Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Workflow {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  enabled     Boolean  @default(true)
  /// Trigger discriminator, e.g. "message_posted".
  trigger     String
  /// Trigger + action parameters, shape depends on `trigger`.
  config      Json
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner               User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members             WorkspaceMember[]
  invites             WorkspaceInvite[]
  channels            Channel[]
  conversations       Conversation[]
  messages            Message[]
  atlassianConnection AtlassianConnection?

  bitbucketSubscriptions BitbucketSubscription[]
  scheduledMessages      ScheduledMessage[]
  customEmojis           CustomEmoji[]
  shareLinks             ShareLink[]
  workflows              Workflow[]
  userGroups             UserGroup[]
  auditLogs              AuditLog[]
  activitySegments       ActivitySegment[]
  huddleSessions         HuddleSession[]
  timesheetEntries       TimesheetEntry[]
  standups               Standup[]
  utilizationDays        UtilizationDaily[]
  incomingWebhooks       IncomingWebhook[]
  customCommands         CustomCommand[]
  weeklyReports          WeeklyReport[]
  decisions              Decision[]
  channelEmails          ChannelEmail[]
  jiraSavedWidgets       JiraSavedWidget[]
  jiraAlertRules         JiraAlertRule[]
  clients                Client[]
  projects               Project[]
  incidents              Incident[]
  oncallShifts           OncallShift[]
  recommendationFeedback RecommendationFeedback[]
  scheduledHuddles       ScheduledHuddle[]
}

model CustomEmoji {
  id          String   @id @default(cuid())
  workspaceId String
  /// Shortcode without colons, e.g. "party-parrot". Unique per workspace.
  name        String
  storageKey  String   @unique
  mimeType    String
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model WorkspaceMember {
  id            String        @id @default(cuid())
  workspaceId   String
  userId        String
  role          WorkspaceRole @default(MEMBER)
  /// Set when the linked Atlassian account is deactivated on the connected site.
  deactivatedAt DateTime?
  /// Opt-in to private workload/wellbeing signals derived from activity data.
  wellbeingOptIn Boolean      @default(false)
  /// Opt-in to a personal daily email digest of unread mentions/notifications.
  dailyDigestOptIn Boolean    @default(false)
  /// The member's UTC offset in minutes, so the digest fires in their local morning.
  digestTzOffsetMin Int       @default(0)
  /// Member-local date (yyyy-mm-dd) the digest last emailed, so it sends once/day.
  digestLastOn  String?
  createdAt     DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  /// Targeted email invite when set; shareable link invite when null.
  email       String?
  role        WorkspaceRole @default(MEMBER)
  /// SHA-256 hash of the invite token; the raw token only appears in the email/link.
  tokenHash   String        @unique
  createdById String
  expiresAt   DateTime
  usedCount   Int           @default(0)
  usedAt      DateTime?
  usedById    String?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreator", fields: [createdById], references: [id])
  usedBy    User?     @relation("InviteUser", fields: [usedById], references: [id])

  @@index([workspaceId])
}

model Channel {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  topic       String?
  description String?
  isPrivate   Boolean   @default(false)
  isArchived  Boolean   @default(false)
  /// The non-leavable, non-deletable #general channel created with the workspace.
  isDefault   Boolean   @default(false)
  /// Sidebar grouping: null = normal channel, else an integration group like "jira"/"confluence".
  groupKey    String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User?                     @relation("ChannelCreator", fields: [createdById], references: [id])
  members           ChannelMember[]
  messages          Message[]
  notifications     Notification[]
  jiraSubscriptions ChannelJiraSubscription[]
  jiraIssueCards    JiraIssueCard[]

  bitbucketSubscriptions BitbucketSubscription[]
  bitbucketPrCards       BitbucketPrCard[]
  scheduledMessages      ScheduledMessage[]
  shareLinks             ShareLink[]
  canvas                 Canvas?
  standups               Standup[]
  incomingWebhooks       IncomingWebhook[]
  channelEmail           ChannelEmail?
  decisions              Decision[]
  weeklyReports          WeeklyReport[]
  jiraAlertRules         JiraAlertRule[]
  scheduledHuddles       ScheduledHuddle[]

  @@unique([workspaceId, name])
}

model ChannelMember {
  id                String           @id @default(cuid())
  channelId         String
  userId            String
  notificationPref  NotificationPref @default(ALL)
  lastReadMessageId String?
  joinedAt          DateTime         @default(now())

  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage Message? @relation("ChannelLastRead", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([channelId, userId])
  @@index([userId])
}

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  isGroup     Boolean  @default(false)
  /// Canonical sorted member user ids joined with ':' — dedupes DMs per member set.
  /// Integration inboxes use a synthetic key (e.g. "jira:<userId>").
  memberKey   String
  /// Display title for integration conversations (e.g. "Jira"); null for normal DMs.
  title       String?
  createdAt   DateTime @default(now())

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members           ConversationMember[]
  messages          Message[]
  notifications     Notification[]
  scheduledMessages ScheduledMessage[]
  scheduledHuddles  ScheduledHuddle[]

  @@unique([workspaceId, memberKey])
}

model ConversationMember {
  id                String   @id @default(cuid())
  conversationId    String
  userId            String
  lastReadMessageId String?
  joinedAt          DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage Message?     @relation("ConversationLastRead", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  workspaceId    String
  channelId      String?
  conversationId String?
  /// Author; null for SYSTEM/INTEGRATION messages (e.g. Jira event cards).
  userId         String?
  kind           MessageKind @default(USER)
  contentJson    Json
  contentText    String
  parentId       String?
  /// Thread replies flagged "also send to channel" appear in the main channel view too.
  showInChannel  Boolean     @default(false)
  isEdited       Boolean     @default(false)
  editedAt       DateTime?
  /// Soft delete: tombstone rendered client-side, row retained.
  deletedAt      DateTime?
  /// Client-generated uuid for idempotent sends; unique per author.
  clientMsgId    String?
  /// Rendered link previews (e.g. Jira issue status cards for pasted URLs).
  unfurls        Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  /// Postgres GENERATED column maintained by the hand-written FTS migration; GIN-indexed.
  searchVector   Unsupported("tsvector")?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent       Message?      @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Message[]     @relation("Thread")

  reactions                   Reaction[]
  attachments                 Attachment[]
  mentions                    Mention[]
  pins                        PinnedMessage[]
  savedBy                     SavedItem[]
  notifications               Notification[]
  channelLastReadMarkers      ChannelMember[]      @relation("ChannelLastRead")
  conversationLastReadMarkers ConversationMember[] @relation("ConversationLastRead")
  jiraIssueCard               JiraIssueCard?
  bitbucketPrCard             BitbucketPrCard?
  shareLinks                  ShareLink[]
  poll                        Poll?

  @@unique([userId, clientMsgId])
  @@index([channelId, createdAt])
  @@index([conversationId, createdAt])
  @@index([parentId])
  @@index([searchVector], type: Gin)
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  /// Emoji shortcode, e.g. "thumbsup".
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId])
}

model Attachment {
  id         String   @id @default(cuid())
  /// Null between upload and message send; linked when the message is created.
  messageId  String?
  uploaderId String
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId])
}

model PinnedMessage {
  id         String   @id @default(cuid())
  messageId  String   @unique
  pinnedById String
  createdAt  DateTime @default(now())

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User    @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
}

model Mention {
  id        String      @id @default(cuid())
  messageId String
  /// The resolved mentioned user (for CHANNEL/HERE one row per affected member).
  userId    String
  type      MentionType @default(USER)
  createdAt DateTime    @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, type])
  @@index([userId])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  actorId        String?
  messageId      String?
  channelId      String?
  conversationId String?
  /// Type-specific extras (e.g. emoji for REACTION, Jira issue key later).
  payload        Json?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user         User          @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 hash of the raw token; raw value never stored.
  tokenHash String    @unique
  /// Rotation family — reuse of a revoked token revokes the whole family.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AtlassianAccountLink {
  id                 String    @id @default(cuid())
  userId             String    @unique
  atlassianAccountId String    @unique
  siteUrl            String
  /// AES-256-GCM encrypted at rest with TOKEN_ENCRYPTION_KEY.
  /// Null for links created by directory sync (no OAuth grant from this user yet).
  accessTokenEnc     String?
  refreshTokenEnc    String?
  scopes             String?
  tokenExpiresAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Workspace-level connection to an Atlassian site (created by OWNER/ADMIN via 3LO).
model AtlassianConnection {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  /// Atlassian cloudId from accessible-resources.
  siteId          String
  siteUrl         String
  siteName        String
  connectedById   String
  accessTokenEnc  String
  refreshTokenEnc String
  scopes          String
  tokenExpiresAt  DateTime?
  /// Shared secret the Jira webhook must present.
  webhookSecret   String
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy   User                      @relation("AtlassianConnector", fields: [connectedById], references: [id])
  subscriptions ChannelJiraSubscription[]
  issueCards    JiraIssueCard[]
}

/// Per-channel Jira project subscription with event filters.
model ChannelJiraSubscription {
  id           String   @id @default(cuid())
  channelId    String
  connectionId String
  projectKey   String
  /// Subset of: comment_created, status_changed, issue_created, issue_assigned.
  events       String[]
  createdAt    DateTime @default(now())

  channel    Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  connection AtlassianConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([channelId, projectKey])
}

/// First card posted for an issue in a channel — follow-up events thread under it.
model JiraIssueCard {
  id           String   @id @default(cuid())
  connectionId String
  channelId    String
  issueKey     String
  messageId    String   @unique
  createdAt    DateTime @default(now())

  connection AtlassianConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  channel    Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message    Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([channelId, issueKey])
}

/// A channel subscribed to one Bitbucket repository's pull request events.
/// Bitbucket is not part of the Jira/Confluence OAuth connection — events are
/// inbound only, so each subscription carries its own webhook secret.
model BitbucketSubscription {
  id            String   @id @default(cuid())
  workspaceId   String
  channelId     String
  /// "workspace/repo-slug" as Bitbucket reports it.
  repoFullName  String
  webhookSecret String
  /// Subset of: pr_created, pr_updated, pr_approved, pr_merged, pr_declined, pr_comment.
  events        String[]
  createdAt     DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  cards     BitbucketPrCard[]

  @@unique([channelId, repoFullName])
}

/// First card posted for a pull request in a channel — follow-ups thread under it.
model BitbucketPrCard {
  id             String   @id @default(cuid())
  subscriptionId String
  channelId      String
  prId           String
  messageId      String   @unique
  createdAt      DateTime @default(now())

  subscription BitbucketSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  channel      Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message      Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([channelId, prId])
}

/// A message queued for later delivery. With a channel/conversation target it
/// is a scheduled send; with neither it is a personal reminder (/remind),
/// delivered as a notification to `userId`.
model ScheduledMessage {
  id             String   @id @default(cuid())
  workspaceId    String
  /// Author of a scheduled send; recipient of a reminder.
  userId         String
  channelId      String?
  conversationId String?
  contentJson    Json
  contentText    String
  scheduledFor   DateTime
  createdAt      DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([scheduledFor])
  @@index([userId])
}

model UserGroup {
  id          String            @id @default(cuid())
  workspaceId String
  /// Display name, e.g. "Engineering".
  name        String
  /// Mention handle without @, e.g. "engineering". Unique per workspace.
  handle      String
  createdById String
  createdAt   DateTime          @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User              @relation("UserGroupCreator", fields: [createdById], references: [id])
  members   UserGroupMember[]

  @@unique([workspaceId, handle])
  @@index([workspaceId])
}

model UserGroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Poll {
  id           String     @id @default(cuid())
  messageId    String     @unique
  question     String
  /// Array of option label strings.
  options      Json
  allowMultiple Boolean   @default(false)
  createdById  String
  createdAt    DateTime   @default(now())

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  votes   PollVote[]
}

model PollVote {
  id          String @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionIndex])
  @@index([pollId])
}

model Canvas {
  id          String   @id @default(cuid())
  channelId   String   @unique
  /// TipTap JSON document.
  contentJson Json
  contentText String   @default("")
  updatedById String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  updatedBy User    @relation("CanvasEditor", fields: [updatedById], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  /// Verb-ish action key, e.g. "channel.delete", "member.role_change".
  action      String
  targetType  String?
  targetId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A block of a user's tracked activity, normalized from every signal source.
/// endedAt/durationSec are null while the block is still open (ongoing).
model ActivitySegment {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  kind        ActivityKind
  source      ActivitySource
  /// Free-form reference: Jira issue key, huddle room key, etc.
  refId       String?
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int?
  meta        Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, startedAt])
  @@index([workspaceId, startedAt])
  // Fast lookup of a user's open segment per (source, kind) when closing it.
  @@index([userId, source, kind, endedAt])
}

/// Persisted record of a huddle (voice/video) session, so meeting time survives
/// the in-memory HuddleService and feeds the timeline.
model HuddleSession {
  id          String              @id @default(cuid())
  workspaceId String
  /// Socket-room key: "channel:X" or "conversation:Y".
  roomKey     String
  startedAt   DateTime            @default(now())
  endedAt     DateTime?

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants HuddleParticipant[]

  @@index([workspaceId, roomKey, endedAt])
}

model HuddleParticipant {
  id        String    @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  session HuddleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}

/// A huddle planned for a future time in a channel or DM. A background queue
/// fires a "starting now" reminder to every member when `scheduledFor` arrives
/// (marking `notifiedAt`), then keeps the row briefly for the upcoming list.
model ScheduledHuddle {
  id             String    @id @default(cuid())
  workspaceId    String
  channelId      String?
  conversationId String?
  createdById    String
  title          String
  scheduledFor   DateTime
  durationMins   Int?
  /// Set once the start reminder has been delivered, so it fires exactly once.
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("ScheduledHuddleCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([scheduledFor])
  @@index([workspaceId])
  @@index([channelId])
  @@index([conversationId])
}

/// A user-entered timesheet entry, mirrored locally and pushed to Jira as a
/// native worklog. jiraWorklogId/syncedAt are null until the push succeeds.
model TimesheetEntry {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  issueKey      String
  startedAt     DateTime
  durationSec   Int
  comment       String?
  jiraWorklogId String?
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, startedAt])
}

/// Nightly per-member rollup of ActivitySegment durations, for fast dashboards.
model UtilizationDaily {
  id                String   @id @default(cuid())
  workspaceId       String
  userId            String
  day               DateTime @db.Date
  meetingSec        Int      @default(0)
  implementationSec Int      @default(0)
  documentationSec  Int      @default(0)
  collaborationSec  Int      @default(0)
  idleSec           Int      @default(0)
  awaySec           Int      @default(0)
  onlineSec         Int      @default(0)
  loggedSec         Int      @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, day])
  @@index([workspaceId, day])
}

/// A recurring async standup: at a scheduled local time on selected weekdays a
/// prompt is posted to `channel`, participants submit check-ins, and a digest
/// is assembled from their responses (plus auto-pulled activity).
model Standup {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  channelId   String
  /// HH:MM in the schedule's local time.
  timeOfDay   String
  /// Weekdays it runs, comma-separated 0-6 (Sun-Sat), e.g. "1,2,3,4,5".
  days        String   @default("1,2,3,4,5")
  /// Minutes east of UTC for the local time above.
  tzOffsetMin Int      @default(0)
  active      Boolean  @default(true)
  /// Schedule-local date (yyyy-mm-dd) the prompt last fired, so it runs once/day.
  lastRunOn   String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User              @relation("StandupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   StandupMember[]
  responses StandupResponse[]

  @@index([workspaceId])
}

model StandupMember {
  id        String @id @default(cuid())
  standupId String
  userId    String

  standup Standup @relation(fields: [standupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([standupId, userId])
}

model StandupResponse {
  id        String   @id @default(cuid())
  standupId String
  userId    String
  /// Schedule-local date the response is for (yyyy-mm-dd).
  onDate    String
  yesterday String   @default("")
  today     String   @default("")
  blockers  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  standup Standup @relation(fields: [standupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([standupId, userId, onDate])
  @@index([standupId, onDate])
}

enum DecisionStatus {
  OPEN
  DECIDED
}

/// Per-channel inbound webhook: external tools POST to /hooks/:token to post a
/// message into the channel (the "for people who ship" integration glue).
model IncomingWebhook {
  id          String   @id @default(cuid())
  workspaceId String
  channelId   String
  token       String   @unique
  name        String
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A workspace-defined slash command that posts a canned response.
model CustomCommand {
  id           String   @id @default(cuid())
  workspaceId  String
  /// Trigger without the leading slash, lowercase, unique per workspace.
  trigger      String
  description  String   @default("")
  responseText String
  createdById  String
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, trigger])
  @@index([workspaceId])
}

/// Config for an automated weekly team report posted to a channel.
model WeeklyReport {
  id          String   @id @default(cuid())
  workspaceId String
  channelId   String
  /// 0=Sun..6=Sat local weekday to post on.
  dayOfWeek   Int      @default(5)
  timeOfDay   String   @default("16:00")
  tzOffsetMin Int      @default(0)
  active      Boolean  @default(true)
  /// Schedule-local date (yyyy-mm-dd) it last fired, so it posts once/week.
  lastRunOn   String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WeeklyReportCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A recorded team decision, optionally anchored to the message that proposed it.
model Decision {
  id          String         @id @default(cuid())
  workspaceId String
  channelId   String
  messageId   String?
  title       String
  detail      String         @default("")
  status      DecisionStatus @default(OPEN)
  outcome     String?
  /// Optional accountable owner for following the decision through.
  ownerId     String?
  /// Optional deadline for reaching / acting on the decision.
  dueAt       DateTime?
  decidedById String?
  decidedAt   DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User      @relation("DecisionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("DecisionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  owner     User?     @relation("DecisionOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([channelId])
  @@index([ownerId])
}

/// A user-saved JQL query pinned as a live count widget on the Atlassian dashboard.
model JiraSavedWidget {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  label       String
  jql         String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("JiraWidgetCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A scheduled rule that posts a digest of overdue / stale / unassigned Jira issues to a channel.
model JiraAlertRule {
  id          String   @id @default(cuid())
  workspaceId String
  channelId   String
  /// Issues untouched for this many days count as "stale".
  staleDays   Int      @default(7)
  active      Boolean  @default(true)
  tzOffsetMin Int      @default(0)
  timeOfDay   String   @default("09:00")
  /// Rule-local date (yyyy-mm-dd) it last fired, so it posts once/day.
  lastRunOn   String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User      @relation("JiraAlertCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Per-channel inbound email address; a mail provider forwards to
/// /inbound-email/:token to post the email into the channel.
model ChannelEmail {
  id          String   @id @default(cuid())
  workspaceId String
  channelId   String   @unique
  token       String   @unique
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

/// A consulting client — groups projects for billability & margin rollups.
model Client {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// A billable project. Time is attributed via its Jira project key (matched
/// against TimesheetEntry.issueKey prefixes).
model Project {
  id             String   @id @default(cuid())
  workspaceId    String
  clientId       String
  name           String
  jiraProjectKey String?
  channelId      String?
  /// Rate charged to the client, in minor units (cents) per hour.
  billRateCents  Int      @default(0)
  /// Internal cost per hour, in minor units — used for margin.
  costRateCents  Int      @default(0)
  budgetHours    Int?
  billable       Boolean  @default(true)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientId])
}

/// A tracked incident with a lifecycle (OPEN → MITIGATED → RESOLVED) and timeline.
model Incident {
  id           String    @id @default(cuid())
  workspaceId  String
  channelId    String?
  title        String
  severity     String    @default("SEV3")
  status       String    @default("OPEN")
  commanderId  String?
  jiraIssueKey String?
  declaredById String
  declaredAt   DateTime  @default(now())
  resolvedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  declaredBy User             @relation("IncidentDeclarer", fields: [declaredById], references: [id], onDelete: Cascade)
  commander  User?            @relation("IncidentCommander", fields: [commanderId], references: [id], onDelete: SetNull)
  updates    IncidentUpdate[]

  @@index([workspaceId])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String?
  /// NOTE | STATUS | MITIGATED | RESOLVED — drives the timeline rendering.
  kind       String   @default("NOTE")
  body       String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User?    @relation("IncidentUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId])
}

/// A single on-call shift; the "current" on-call is whoever's window covers now.
model OncallShift {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  label       String   @default("Primary")
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
}

/// A user's calendar feed (ICS URL). The poller sets an "In a meeting" status
/// and logs MEETING activity during events.
model CalendarLink {
  id         String    @id @default(cuid())
  userId     String    @unique
  icsUrl     String
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Per-user feedback on a recommendation the engine surfaced. `refId` is the
/// recommendation's stable target key (a userId, channelId, issue key, decision
/// id, …), scoped by `kind`. A DISMISSED row suppresses that suggestion for a
/// cool-off window; ACTED rows train future ranking. The engine is otherwise
/// stateless — this is the only recommendation state we persist.
model RecommendationFeedback {
  id          String               @id @default(cuid())
  workspaceId String
  userId      String
  kind        RecommendationKind
  refId       String
  action      RecommendationAction
  createdAt   DateTime             @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One feedback row per (user, kind, target): re-acting upserts.
  @@unique([userId, kind, refId])
  @@index([workspaceId, userId, kind])
}
