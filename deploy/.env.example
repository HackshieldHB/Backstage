# Copy to deploy/.env and fill in. Used by deploy/docker-compose.prod.yml both
# for ${...} interpolation and as the API's environment.

# ---- public URLs (no trailing slash) -----------------------------------------
# Where people open Backstages, and where the browser reaches the API.
# With the Cloudflare tunnel profile these are your two tunnel hostnames, e.g.
#   WEB_URL=https://chat.example.com   API_URL=https://chat-api.example.com
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
WEB_PORT=3000
API_PORT=3001

# ---- HTTPS on this server (--profile https, Caddy + Let's Encrypt) ----------
# Hostnames only (no https://). DNS must point here and TCP 80/443 must reach
# this machine. With Caddy in front, keep the apps private:
#   WEB_PORT=127.0.0.1:3000   API_PORT=127.0.0.1:3001
WEB_HOST=
API_HOST=
SFU_HOST=
# HTTPS on another port when 443 can't reach this machine (TCP 80 still must).
# Then include it in the URLs: WEB_URL=https://chat.example.com:445
HTTPS_PORT=443

# ---- secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
TOKEN_ENCRYPTION_KEY=

# ---- Cloudflare named tunnel (--profile tunnel) -----------------------------
# Zero Trust → Networks → Tunnels → Create → Cloudflared → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Web Push (meeting reminders with no tab open) ---------------------------
# node -e "console.log(require('web-push').generateVAPIDKeys())"   (inside apps/api)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Huddle relay (TURN) -----------------------------------------------------
# With --profile turn: TURN_URLS=turn:<server public IP or host>:3478 and a long
# random TURN_SECRET. Or use Cloudflare TURN instead (CLOUDFLARE_TURN_*).
TURN_URLS=
TURN_SECRET=
TURN_REALM=backstages
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ---- Email (invites, password reset, verification) ---------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Backstages <no-reply@example.com>

# ---- Sign in with Google / GitHub (optional) --------------------------------
# Callbacks: ${API_URL}/auth/oauth/google/callback and ${API_URL}/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: previews for private repos you follow (docs/github.md)
GITHUB_API_TOKEN=

# ---- Optional -----------------------------------------------------------------
SENTRY_DSN=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# ---- Large meetings: LiveKit SFU (--profile livekit) --------------------------
# Needs TCP 7881 + UDP 50000-50100 reaching this machine 1:1, and SFU_HOST for
# the wss endpoint. Leave LIVEKIT_URL EMPTY until those ports are open: as soon
# as it is set, every huddle switches from peer-to-peer to the SFU.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The API (in Docker) reaches LiveKit (host network) here:
LIVEKIT_API_URL=http://host.docker.internal:7880
# Public IP that clients send media to (required behind NAT).
LIVEKIT_NODE_IP=
# Server recording via LiveKit Egress (needs an Egress worker): 1 to enable.
LIVEKIT_EGRESS=
