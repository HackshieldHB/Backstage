# Copy to deploy/.env and fill in. Used by deploy/docker-compose.prod.yml both
# for ${...} interpolation and as the API's environment.

# ---- public URLs (no trailing slash) -----------------------------------------
# Where people open Backstages, and where the browser reaches the API.
# With the Cloudflare tunnel profile these are your two tunnel hostnames, e.g.
#   WEB_URL=https://chat.example.com   API_URL=https://chat-api.example.com
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
WEB_PORT=3000
API_PORT=3001

# ---- secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
TOKEN_ENCRYPTION_KEY=

# ---- Cloudflare named tunnel (--profile tunnel) -----------------------------
# Zero Trust → Networks → Tunnels → Create → Cloudflared → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Web Push (meeting reminders with no tab open) ---------------------------
# node -e "console.log(require('web-push').generateVAPIDKeys())"   (inside apps/api)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Huddle relay (TURN) -----------------------------------------------------
# With --profile turn: TURN_URLS=turn:<server public IP or host>:3478 and a long
# random TURN_SECRET. Or use Cloudflare TURN instead (CLOUDFLARE_TURN_*).
TURN_URLS=
TURN_SECRET=
TURN_REALM=backstages
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ---- Email (invites, password reset, verification) ---------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Backstages <no-reply@example.com>

# ---- Sign in with Google / GitHub (optional) --------------------------------
# Callbacks: ${API_URL}/auth/oauth/google/callback and ${API_URL}/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Optional -----------------------------------------------------------------
SENTRY_DSN=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
